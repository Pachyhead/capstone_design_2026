# 서버(GPU) 머신용 예시. 저장소 루트에 .env로 복사해서 사용합니다.
#   cp .env.server.example .env

# gRPC 서버가 열 포트
SERV_PORT=

# MySQL root 비밀번호 (grpc_getting_started/file_speech_handler.py)
DB_PASSWORD=

# TLS: 1이면 TLS, 비우거나 0이면 평문 (기본값 평문)
SERV_TLS=0

# SERV_TLS=1일 때만 필요. 절대 경로 권장. 두 파일은 git에 올라가지 않으므로 서버에 직접 두어야 합니다.
SERVER_CERT_PATH= # .pem
SERVER_KEY_PATH= # .key
