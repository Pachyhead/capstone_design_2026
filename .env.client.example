# 클라이언트(엔드포인트) 머신용 예시. 저장소 루트에 .env로 복사해서 사용합니다.
#   cp .env.client.example .env
# 목 서버(endpoint/mock_relay.py)도 같은 파일을 읽습니다.

# 접속할 gRPC 서버 주소. TLS일 때는 서버 인증서 SAN의 IP와 같아야 합니다.
SERV_IP=
SERV_PORT=

# TLS: 1이면 TLS, 비우거나 0이면 평문 (기본값 평문). 서버와 같은 값이어야 합니다.
SERV_TLS=0

# SERV_TLS=1일 때만 필요. 절대 경로 권장.
#   실서버: grpc_getting_started/certs/ca.pem
#   목 서버: endpoint/mock_certs/ca.pem (endpoint/gen_mock_certs.sh로 생성)
CA_CERT_PATH=
